<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/barmaan_background">

    <TextView
        android:id="@+id/clock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textColor="@color/barmaan_text"
        android:textSize="34sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <TextView
        android:id="@+id/date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BarmaanOS"
        android:textColor="@color/barmaan_secondary_text"
        android:textSize="15sp"
        android:gravity="center"
        android:layout_marginBottom="18dp"/>

    <EditText
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="@string/search_apps"
        android:singleLine="true"
        android:textColor="@color/barmaan_text"
        android:textColorHint="@color/barmaan_secondary_text"
        android:background="@color/barmaan_card"
        android:padding="14dp"/>

    <TextView
        android:id="@+id/welcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/launcher_title"
        android:textColor="@color/barmaan_text"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"/>

    <TextView
        android:id="@+id/appCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Apps"
        android:textColor="@color/barmaan_secondary_text"
        android:textSize="14sp"
        android:layout_marginTop="4dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp">

        <GridLayout
            android:id="@+id/appGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="true"/>

    </ScrollView>

    <Button
        android:id="@+id/settingsButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/settings"
        android:textAllCaps="false"/>

</LinearLayout>
